# --- החשבון שמתחבר ומושך את הנתונים (אם החשבון הנבדק פרטי, חייב לעקוב אחריו) ---
IG_USERNAME=your_ig_account
IG_PASSWORD=your_ig_password
# אם בחשבון יש 2FA: המפתח של אפליקציית האימות (Authentication app), השרת ייצר קודים לבד.
# בלי זה הבוט יבקש ממך קוד בטלגרם בכל התחברות מחדש.
IG_TOTP_SECRET=

# --- החשבון שבודקים את העוקבים שלו (בלי @) ---
TARGET_USERNAME=target_account

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...
# אפשר כמה צ'אטים מופרדים בפסיק. כולם מקבלים התראות ויכולים לשלוט בבוט
TELEGRAM_CHAT_ID=123456789

# --- אופציונלי ---
# IG_PROXY=http://user:pass@residential-proxy:port
CHECK_INTERVAL_HOURS=6
# כמה משיכות של הרשימה לאחד בכל בדיקה (כל משיכה ~30 בקשות). 7 משיכות × 5 בדיקות ביום = חסימת קצב.
FETCH_PASSES=3
# ירידת עוקב מדווחת רק אחרי שהוא חסר ב-N בדיקות ברצף (עוקב חדש: 2)
LOST_CONFIRM_CHECKS=3
# אחרי חסימת קצב (feedback_required): הפסקה מלאה, גם לבדיקות ידניות
LIMIT_COOLDOWN_HOURS=24
# אחרי תקלה זמנית (לא בעיית התחברות), ניסיון חוזר בעוד:
RETRY_MINUTES=60
# הודעה שקטה גם כשאין שינויים (סימן חיים: אם היא לא מגיעה, השרת נפל)
REPORT_NO_CHANGES=true
NOTIFY_NEW_FOLLOWERS=true
# מתחת ל-X% מבסיס התצפיות ההיסטורי הסריקה מסומנת בדוח "נראית חלקית" (אזהרה בלבד, לא חוסם)
MIN_FETCH_RATIO=0.9
JITTER_MAX_SEC=600
TIMEZONE=Asia/Jerusalem
